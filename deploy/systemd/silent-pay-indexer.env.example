# Runtime mode: this makes the app load config/config.yaml by default.
NODE_ENV=prod

# Optional runtime overrides for config/config.yaml.
# Use these only when you want to override YAML without editing the file.
APP_PORT=3000
DB_PATH=/var/lib/silent-pay-indexer/database.sqlite
DB_SYNCHRONIZE=false
APP_NETWORK=main
PROVIDER_TYPE=BITCOIN_CORE_RPC
BITCOIN_CORE_PROTOCOL=http
BITCOIN_CORE_RPC_HOST=127.0.0.1
BITCOIN_CORE_RPC_PORT=8332
BITCOIN_CORE_RPC_USER=change-me
BITCOIN_CORE_RPC_PASS=change-me
THROTTLER_TTL=1000
THROTTLER_LIMIT=20
CACHE_TTL=5000
